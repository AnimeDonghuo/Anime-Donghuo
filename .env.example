NODE_ENV=development
PORT=8000
# Set to 1 only when running behind exactly one trusted reverse proxy (Arena preview, for example).
TRUST_PROXY=

# MongoDB Atlas or another TLS-enabled MongoDB deployment. Leave blank for local in-memory demo mode.
MONGODB_URI=

# Leave blank for disposable local development (random ephemeral keys are generated).
# For Koyeb/production, generate and store each key as a secret:
#   SESSION_SECRET=$(openssl rand -hex 32)
#   EMAIL_LOOKUP_SECRET=$(openssl rand -hex 32)
#   DATA_ENCRYPTION_KEY=$(openssl rand -base64 32)
SESSION_SECRET=
EMAIL_LOOKUP_SECRET=
DATA_ENCRYPTION_KEY=

# Optional: exact public site origin, e.g. https://your-app.koyeb.app
# PUBLIC_ORIGIN=

# Optional artwork providers. Keep credentials in the deployment secret store.
# MAL_CLIENT_ID=         # MyAnimeList v2 API client ID (tried before AniList)
# TMDB_API_KEY=          # TMDB v3 API key
# TMDB_READ_ACCESS_TOKEN= # Alternative TMDB v4 read token
# IMGBB_API_KEY=         # Official ImgBB API key used to host/cache poster images
# ANIMEXIN_ENABLED=false # Set true only after confirming automated poster reuse is permitted.
# ANIMEXIN_BASE_URL=https://animexin.dev
# ANIMEXIN_IMAGE_HOSTS= # Comma-separated public CDN hostnames used by Animexin posters, if any
# POSTER_SYNC_ENABLED=true # In production, poster sync is enabled unless set to false

# Optional Telegram admin poster/link bot. The webhook only accepts listed admins.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET= # Generate a random 32+ character URL-safe value
# TELEGRAM_ADMIN_IDS=      # Comma-separated numeric Telegram user IDs
