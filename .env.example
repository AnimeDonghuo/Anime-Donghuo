NODE_ENV=development
PORT=8000
# Set to 1 only when running behind exactly one trusted reverse proxy (Arena preview, for example).
TRUST_PROXY=

# MongoDB Atlas or another TLS-enabled MongoDB deployment. Leave blank for local in-memory demo mode.
MONGODB_URI=

# Leave blank for disposable local development (random ephemeral keys are generated).
# For Koyeb/production, generate and store each key as a secret:
#   SESSION_SECRET=$(openssl rand -hex 32)
#   EMAIL_LOOKUP_SECRET=$(openssl rand -hex 32)
#   DATA_ENCRYPTION_KEY=$(openssl rand -base64 32)
SESSION_SECRET=
EMAIL_LOOKUP_SECRET=
DATA_ENCRYPTION_KEY=

# Optional: exact public site origin, e.g. https://your-app.koyeb.app
# PUBLIC_ORIGIN=
